# WorkNest Root .gitignore

# Dependencies & Build Artifacts
node_modules/
dist/
dist-ssr/
dev-dist/
target/
build/
*.class

# Environment & SSL Keys
.env
.env.local
*.key
*.crt

# Logs & Temporary files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db
*.tmp

# IDE & Editor files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.settings/
.project
.classpath

# Exclude other unrelated workspace projects
/NIELL/
/codersway-backend/
/codersway-frontend/
/copyEducation_hub/
/premium-website/
/premium-wp-theme/
/premium-wp-theme.zip
/app.zip
/generate_presentation_pdf.py
/WorkNest_Phase2_Presentation.pdf
